# Database (Supabase Postgres URI or local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jain_coaching

# NextAuth
NEXTAUTH_URL=http://127.0.0.1:3333
NEXTAUTH_SECRET=generate-a-long-random-secret

# Google OAuth (optional — email/password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email notifications (optional — logs to DB if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jain-coaching.local

# WhatsApp via Twilio (optional — requires student WhatsApp consent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
