# Use npm registry (matches npm / corporate TLS); avoids registry.yarnpkg.com redirects.
registry "https://registry.npmjs.org/"

# Corporate proxy / antivirus HTTPS inspection replaces TLS certs with a private CA.
# Node then fails yarn install/audit with "self-signed certificate in certificate chain".
# Prefer exporting your org root CA and setting NODE_EXTRA_CA_CERTS (see README).
strict-ssl false
